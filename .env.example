GOOGLE_API_KEY=
PINECONE_API_KEY=

# Google OAuth (Cloud Console → APIs & Services → Credentials). Add
# http://localhost:5173/api/auth/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Supabase project URL + service_role key (server-side only, never sent to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Only needed when deploying somewhere other than local dev:
# FRONTEND_URL=https://your-domain.com
# OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/callback
# SESSION_HTTPS_ONLY=1
